# Application Configuration
APP_NAME="UAIC Claim & RPA Orchestrator"
APP_ENV="development"
DEBUG=True
API_V1_PREFIX="/api/v1"
SECRET_KEY="supersecretdevelopmentkeyfororchestrator"

# CORS Configuration
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# Database Configuration (PostgreSQL in Docker / SQLite for local development)
DATABASE_URL="sqlite+aiosqlite:///./orchestrator.db"
# For PostgreSQL:
# DATABASE_URL="postgresql+asyncpg://postgres:postgres@localhost:5432/uaic_orchestrator"

# Redis & Celery Configuration
REDIS_URL="redis://localhost:6379/0"
CELERY_BROKER_URL="redis://localhost:6379/0"
CELERY_RESULT_BACKEND="redis://localhost:6379/1"

# Fuzzy Match Engine
FUZZY_MATCH_DEFAULT_THRESHOLD=0.60
FUZZY_MATCH_BORDERLINE_THRESHOLD=0.40

# Downstream Integration (Guidewire Activity Creation)
GUIDEWIRE_API_URL="https://uaic-gwcp-prod-igoauthproxy.api.delta4-andromeda.guidewire.net/api/powerapps/caseupdate"
GUIDEWIRE_API_KEY=""

# Web Automation / Playwright Settings
PLAYWRIGHT_HEADLESS=True
PLAYWRIGHT_TIMEOUT_MS=30000
PLAYWRIGHT_VIEWPORT_WIDTH=1280
PLAYWRIGHT_VIEWPORT_HEIGHT=800
