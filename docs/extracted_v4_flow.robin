        SET DualSearch TO $fx'=Int(2)'
        SET TripleSearch TO $fx'=Int(1)'
    ELSE IF $fx'=VarDriverFirstName = VarClaimantFirstName And VarDriverLastName = VarClaimantLastName And VarDriverFirstName <> VarInsuredFirstName And VarDriverLastName <> VarInsuredLastName' THEN
        SET DualSearch TO $fx'=Int(2)'
        SET TripleSearch TO $fx'=Int(1)'
