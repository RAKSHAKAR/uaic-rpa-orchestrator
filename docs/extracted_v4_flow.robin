        SET TripleSearch TO $fx'=Int(1)'
    ELSE IF $fx'=VarInsuredFirstName = VarDriverFirstName And VarInsuredLastName = VarDriverLastName And VarInsuredFirstName <> VarClaimantFirstName And VarInsuredLastName <> VarClaimantLastName' THEN
