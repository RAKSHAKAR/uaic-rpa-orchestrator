FUNCTION Subflow_ErrorImage GLOBAL
    DISABLE IF (File.IfFile.Exists File: $fx'%ScreenshotFolderPath%') THEN
        DISABLE File.Delete Files: $fx'%ScreenshotFolderPath%'
    DISABLE END
    DISABLE Workstation.TakeScreenshot.TakeScreenshotAndSaveToFile File: $fx'%ScreenshotFolderPath%' ImageFormat: System.ImageFormat.Jpg
    DISABLE EXIT FUNCTION
END FUNCTION
FUNCTION Subflow_RecordFailing GLOBAL
    DateTime.GetCurrentDateTime.Local DateTimeFormat: DateTime.DateTimeFormat.DateAndTime CurrentDateTime=> CurrentDatetime
    Text.ConvertDateTimeToText.FromDateTime DateTime: $fx'${CurrentDatetime}' StandardFormat: Text.WellKnownDateTimeFormat.FullDateTimeShortTime Result=> FormattedDateTime
    Text.Replace.ReplaceTextWithRegex Text: $fx'${FormattedDateTime}' TextToFind: $fx'[^\\w\\.@-]' IgnoreCase: False ReplaceWith: $fx'-' ActivateEscapeSequences: False Result=> Replaced
    DISABLE Workstation.TakeScreenshot.TakeScreenshotAndSaveToFile File: $fx'C:\\Users\\pdadmin\\Desktop\\Error Screenshots\\%Replaced%.jpg' ImageFormat: System.ImageFormat.Jpg
    DISABLE Workstation.TakeScreenshot.TakeScreenshotAndSaveToFile File: $fx'C:\\Users\\Apoorvn1\\Desktop\\Error Screenshots\\${Replaced}.jpg' ImageFormat: System.ImageFormat.Jpg
    @@organization: '(Current)'
