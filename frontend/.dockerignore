# ==============================================================================
# UAIC Frontend — Docker Ignore File
# Excludes local node_modules, build caches, test artifacts, logs, and
# sensitive configurations from Docker build context.
# ==============================================================================

# Version Control & IDE
.git
.git/**
.github
.github/**
.vscode
.vscode/**
.idea
.idea/**

# Dependencies & Build Output
node_modules
node_modules/**
.next
.next/**
out
out/**
build
build/**
dist
dist/**

# Testing, Analysis & Coverage
coverage
coverage/**
.turbo
.turbo/**
test-results
test-results/**
playwright-report
playwright-report/**
blob-report
blob-report/**

# Local Secrets & Environment Variables
.env
.env.*
!.env.example

# Logs & Debugging
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# OS Artifacts & Keys
.DS_Store
Thumbs.db
*.pem
*.key
