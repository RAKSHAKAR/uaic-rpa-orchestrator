# Frontend Environment Variables Template
# Vercel / Netlify / Cloud Edge / Standalone Container Configuration

# Direct backend API base URL (takes highest priority in API client)
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1

# Backward-compatible API URL alias
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# Node environment
NODE_ENV=development
