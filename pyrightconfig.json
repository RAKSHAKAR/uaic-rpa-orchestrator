{
  "include": [
    "backend",
    "scripts",
    "e2e"
  ],
  "exclude": [
    "backend/.venv",
    "**/node_modules",
    "**/__pycache__",
    "frontend"
  ],
  "typeCheckingMode": "off",
  "reportMissingImports": "none",
  "extraPaths": [
    "backend"
  ],
  "executionEnvironments": [
    {
      "root": ".",
      "extraPaths": [
        "backend"
      ]
    }
  ],
  "venvPath": "backend",
  "venv": ".venv"
}
